{
  "name": "@ken-platform/identity-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests vite.config.ts --max-warnings 0 && prettier --check src tests *.json *.ts *.mjs index.html",
    "build": "vite build",
    "verify:build": "pnpm typecheck && pnpm lint && pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.3",
    "eslint-plugin-vue": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "29.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
