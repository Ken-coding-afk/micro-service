{
  "uid": "framework-services",
  "title": "服务运行概览",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "采集目标状态（无数据表示未采集）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"services\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Java HTTP p95 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,service) (rate(http_server_requests_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Python HTTP p95 秒",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,service) (rate(platform_http_request_duration_seconds_bucket[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Java HTTP 错误率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by(service)(rate(http_server_requests_seconds_count[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Python HTTP 错误率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(rate(platform_http_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum by(service)(rate(platform_http_request_duration_seconds_count[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "JVM 堆使用字节",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(jvm_memory_used_bytes{area=\"heap\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "网关 Redis 限流拒绝",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route,reason)(rate(platform_gateway_rejected_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Sentinel 熔断转换",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(rate(platform_circuit_transitions_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Python 保护拒绝",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,reason)(rate(platform_protection_rejected_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Python 断路器状态 0关闭 1打开 2探测",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_dependency_circuit_state"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "网关总预算超时",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route)(rate(platform_gateway_budget_timeout_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据"
        },
        "overrides": []
      }
    }
  ]
}