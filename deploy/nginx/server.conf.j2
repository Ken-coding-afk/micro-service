# 不记录查询、Referer、凭据头或请求体；原生 HTTP 错误日志可能携带完整请求 URI。
log_format framework_safe escape=json
    '{"time":"$time_iso8601","edge_request_id":"$request_id",'
    '"request_id":"$http_x_request_id","method":"$request_method","uri":"$uri",'
    '"status":$status,"bytes":$body_bytes_sent,"duration":$request_time,'
    '"upstream_status":"$upstream_status","upstream_addr":"$upstream_addr",'
    '"upstream_duration":"$upstream_response_time"}';
error_log /dev/null;

upstream application_gateway {
{% for endpoint in edge_gateway_upstreams %}
    server {{ endpoint }};
{% endfor %}
    keepalive 32;
}
server {
    access_log /dev/stdout framework_safe;
    listen 8080;
    server_name {{ edge_server_name }};
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location / { return 308 https://{{ edge_server_name }}$request_uri; }
}
server {
    access_log /dev/stdout framework_safe;
    listen 8443 ssl;
    add_header Strict-Transport-Security "max-age=31536000" always;
    server_name {{ edge_server_name }};
    server_tokens off;
    ssl_certificate /etc/nginx/tls/current/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    root /usr/share/nginx/html;
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
        # location 中有 add_header 时不会继承 server 的响应头。
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
    location ~ ^/(internal/|actuator/) { return 404; }
    location ~ ^/(api/|identity/|oauth2/|login/oauth2/|\.well-known/|bff/|connect/|userinfo$) {
        proxy_pass http://application_gateway;
        proxy_connect_timeout 2s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Service-Authorization "";
        proxy_set_header X-Tenant-Id "";
        proxy_set_header X-User-Id "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
