# 本地环境绑定样例(设计 02·环境文件与秘密注入)。
# 实际 .local/environment.env 由 `uv run --frozen python tools/infra/init.py
# --env-file .local/environment.env --phase prepare-local` 生成:
# <generated> 占位符替换为随机值;该文件被 Git 忽略,秘密不进仓库。
# test/prod 环境只提交同结构的非敏感部分,凭证走 secret 文件引用。

PROJECT_CODE=sample-project
APP_ENV=local
PG_MODE=self_hosted
REDIS_MODE=self_hosted
NACOS_MODE=self_hosted
RABBIT_MODE=self_hosted

# 入口与内部身份地址(本地 loopback HTTP 例外仅限 local,设计 03·本地运行)
PUBLIC_ORIGIN=http://localhost:18080
IDENTITY_INTERNAL_ORIGIN=http://identity-service:8081
# identity-service 必填；仅向身份进程挂载，内容不进入 Nacos/Git。
# IDENTITY_SIGNING_JWK_SECRET_FILE=C:/absolute/controlled/identity-signing.json
# 仅 bootstrap 维护进程挂载；JSON 内只含初始账号名称及绝对秘密文件引用，不传入常驻服务。
# IDENTITY_BOOTSTRAP_SECRET_FILE=C:/absolute/controlled/identity-bootstrap.json

# 组件地址(容器网络别名由 deploy/compose.yaml 使用;宿主机调试走 loopback 映射端口)
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_CONSOLE_ADDR=http://127.0.0.1:8080
NACOS_NAMESPACE=<resolved-by-prepare-local>
PG_HOST=127.0.0.1
PG_PORT=15432
# JDBC 服务的进程绑定由资源清单解析后单独注入；每个服务只能拿自己的 runtime 身份。
# DB_NAME=sample_project_local_identity
# DB_USER=sample_project_local_identity_runtime
# DB_PASSWORD_SECRET_FILE=C:/absolute/controlled/identity-runtime.password
# 各资源服务使用自己独立的内省客户端；不得注入其他服务的秘密。
# RESOURCE_AUDIENCE=document-service
# INTROSPECTION_CLIENT_ID=sample-project-local-document-introspect
# INTROSPECTION_CLIENT_SECRET_FILE=C:/absolute/controlled/document-introspect.password
# Gateway 的独立 audience -> client_id/secret_file 清单；不复用业务服务内省凭据。
# GATEWAY_INTROSPECTION_CLIENTS_SECRET_FILE=C:/absolute/controlled/gateway-readers.json
# Gateway BFF 描述：仅绝对秘密文件引用；两个固定管理客户端必填，业务 web 可选。
# GATEWAY_BFF_CLIENTS_SECRET_FILE=C:/absolute/controlled/gateway-bff.json
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_CONF_FILE=.local/redis/redis.conf
# Rabbit 仅需要消息时启用(compose --profile mq)
RABBIT_HOST=
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672
S3_ENDPOINT=

# 本地组件管理员凭证(prepare-local 生成;test/prod 由 secret 系统提供)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=<generated>
REDIS_PASSWORD=<generated>
NACOS_ADMIN_USER=nacos
NACOS_ADMIN_PASSWORD=<generated>
NACOS_PUBLISH_USER=sample-project-local-publisher
NACOS_PUBLISH_PASSWORD=<generated>
NACOS_RUNTIME_USER=sample-project-local-runtime
NACOS_RUNTIME_PASSWORD=<generated>
NACOS_AUTH_TOKEN=<generated>
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=<generated>
RABBIT_ADMIN_USER=admin
RABBIT_ADMIN_PASSWORD=<generated>

# 同机第二项目/环境配置另一组宿主端口；连接字段也使用对应宿主端口。
PG_PUBLISHED_PORT=15432
REDIS_PUBLISHED_PORT=16379
NACOS_PUBLISHED_PORT=8848
NACOS_GRPC_PUBLISHED_PORT=9848
NACOS_CONSOLE_PUBLISHED_PORT=8080
RABBIT_PUBLISHED_PORT=5672
RABBIT_MANAGEMENT_PUBLISHED_PORT=15672
