# 本地环境绑定样例(设计 02·环境文件与秘密注入)。
# 实际 .local/environment.env 由 `uv run --frozen python infra/init/run.py
# --env-file .local/environment.env --phase prepare-local` 生成:
# <generated> 占位符替换为随机值;该文件被 Git 忽略,秘密不进仓库。
# test/prod 环境只提交同结构的非敏感部分,凭证走 secret 文件引用。

PROJECT_CODE=doc-insight
APP_ENV=local

# 入口与内部身份地址(本地 loopback HTTP 例外仅限 local,设计 03·本地运行)
PUBLIC_ORIGIN=http://localhost:18080
IDENTITY_INTERNAL_ORIGIN=http://api-gateway:8080

# 组件地址(容器网络别名由 deploy/compose.yaml 使用;宿主机调试走 loopback 映射端口)
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_CONSOLE_ADDR=http://127.0.0.1:8080
NACOS_NAMESPACE=<resolved-by-prepare-local>
PG_HOST=127.0.0.1
PG_PORT=15432
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_CONF_FILE=.local/redis/redis.conf
# Rabbit 仅文档异步/聊天组合启用(compose --profile mq)
RABBIT_HOST=
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672
S3_ENDPOINT=

# 本地组件管理员凭证(prepare-local 生成;test/prod 由 secret 系统提供)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=<generated>
REDIS_PASSWORD=<generated>
NACOS_ADMIN_USER=nacos
NACOS_ADMIN_PASSWORD=<generated>
NACOS_AUTH_TOKEN=<generated>
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=<generated>
RABBIT_ADMIN_USER=admin
RABBIT_ADMIN_PASSWORD=<generated>
