# 每个服务分别保存为 ${RUNTIME_DIR}/<service>.env，不能直接把管理员环境文件传入应用。
# 示例为 Java；Python 改 SERVICE_NAME、端口、DB 和内省凭据。
PROJECT_CODE=sample-project
APP_ENV=local
SERVICE_NAME=sample-java-service
SERVICE_BIND_HOST=0.0.0.0
SERVICE_BIND_PORT=8082
SERVICE_ADVERTISE_HOST=sample-java-service
SERVICE_ADVERTISE_PORT=8082
SERVICE_SCHEME=http
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=sample-project-local
NACOS_RUNTIME_USER=sample-project-local-runtime
NACOS_RUNTIME_PASSWORD_SECRET_FILE=/run/secrets/nacos-runtime.password
PUBLIC_ORIGIN=http://localhost:18080
PG_HOST=postgres
PG_PORT=5432
DB_NAME=sample_project_local_sample_java
DB_USER=sample_project_local_sample_java_runtime
DB_PASSWORD_SECRET_FILE=/run/secrets/database.password
RESOURCE_AUDIENCE=sample-java-service
INTROSPECTION_CLIENT_ID=sample-java-introspect
INTROSPECTION_CLIENT_SECRET_FILE=/run/secrets/introspection.password
# 仅双语言示例启用；另一服务启动前此发现不应阻塞本服务 ready。
# PEER_SERVICE=sample-python-service
