# 复制为每个待调试服务独立的 .local/<service>-host.env。
# 不填写 PROJECT_CODE/APP_ENV/NACOS_NAMESPACE/PUBLIC_ORIGIN/DB_NAME/DB_USER。
SERVICE_BIND_HOST=0.0.0.0
SERVICE_BIND_PORT=8083
SERVICE_ADVERTISE_HOST=host.docker.internal
SERVICE_ADVERTISE_PORT=8083
# 宿主存在系统代理时，显式追加实际 DEV_HOST；不要使用 *。
NO_PROXY=localhost,127.0.0.1,host.docker.internal
PG_HOST=127.0.0.1
PG_PORT=15432
NACOS_SERVER_ADDR=127.0.0.1:8848
IDENTITY_INTERNAL_ORIGIN=http://localhost:18081
DB_PASSWORD_SECRET_FILE=/absolute/project/.local/runtime/sample-python-service-secrets/database.password
NACOS_RUNTIME_PASSWORD_SECRET_FILE=/absolute/project/.local/runtime/sample-python-service-secrets/nacos-runtime.password
INTROSPECTION_CLIENT_SECRET_FILE=/absolute/project/.local/runtime/sample-python-service-secrets/introspection.password
